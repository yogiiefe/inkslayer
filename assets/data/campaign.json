      ]
    },
    {
      "name": "Food",
      "opening": [
        "At this kitchen, everyone must pass an exam before they eat.",
        "Inside the shelter, someone tells me Kotoba is checking the queue himself.",
        "I follow the smell of food to a line of hungry people.",
        "Nine examiners stand between me and his desk.",
        "Kotoba keeps one hand on the ledger that missed my name.",
        "This time, I step forward before he can look away.",
        "I take out my pen and wait for the first question."
      ],
      "encounters": [
        {"id":"s4-01","name":"Examiner I","element":"FIRE","attacks":["FIRE","WATER"],"health":44,"damage":8,"lessonId":"水"},
        {"id":"s4-02","name":"Examiner II","element":"METAL","attacks":["METAL","EARTH"],"health":46,"damage":8,"lessonId":"金"},
