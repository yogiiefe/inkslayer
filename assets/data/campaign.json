    {"text": "ペン", "meaning": "Pen", "romaji": "pen", "note": "ペ is pe. The small circle changes ヘ to ペ."},
    {"text": "インク", "meaning": "Ink", "romaji": "inku"},
    {"text": "ペット", "meaning": "Pet", "romaji": "petto", "note": "Small ッ makes a short pause before ト, written as doubled t in romaji."},
    {"text": "ケージ", "meaning": "Cage", "romaji": "keeji", "note": "ー lengthens the e in ケ. The marks on シ make ジ (ji)."},
    {"text": "ハムスター", "meaning": "Hamster", "romaji": "hamusutaa", "note": "ー lengthens the a in タ."},
    {"text": "コート", "meaning": "Coat", "romaji": "kooto", "note": "ー lengthens the o in コ."},
    {"text": "ブーツ", "meaning": "Boots", "romaji": "buutsu", "note": "The marks on フ make ブ (bu). ー lengthens its u."},
    {"text": "タオル", "meaning": "Towel", "romaji": "taoru"}
  ],
